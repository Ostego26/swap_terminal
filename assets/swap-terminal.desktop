[Desktop Entry]
Type=Application
Version=1.0
# THE NAME AND COMMENT SAY WHICH DEPLOYMENT THIS IS, and they did not.
#
# Measured on the operator's host 2026-10-09: they clicked "Swap Terminal" and
# got a host gunicorn on :5000 reporting all five chains NOT CONFIGURED, because
# nothing in the serving path reads a .env (swap_terminal/config.py:17 says so,
# deliberately -- load_dotenv() at import makes every later import
# order-dependent). `docker compose` reads .env by itself, so the CONTAINERIZED
# stack gets the chain ports and this one does not.
#
# The old Comment read "Start the swap terminal, open its window, and stop
# everything when the window closes" -- true of what it does and wrong about
# what it IS. An operator clicking a thing called "Swap Terminal" expects the
# swap terminal, and an icon carries no other documentation (rule 16: a wrong
# comment is a bug, and this one is in the only place a one-click user reads).
Name=Swap Terminal: Window (dev server)
GenericName=Atomic swap terminal, host dev server
Comment=HOST gunicorn on :5000 with whatever the launching shell exported -- it reads NO .env, so chains are usually NOT CONFIGURED. For the real stack use the Up icon or `swapterm up` (containerized, :5100, reads .env). Closing this window stops this server.
# Exec IS REWRITTEN BY install_desktop_icon.py, because a .desktop Exec= must be an
# ABSOLUTE path -- the desktop runs it with a minimal environment and no working
# directory of ours, so a relative path or a bare name finds nothing. The token
# below is a placeholder the installer replaces with the real resolved path; this
# file is a template and is NOT itself a working launcher.
Exec=__SWAP_TERMINAL_EXEC__
Icon=__SWAP_TERMINAL_ICON__
# Terminal=true DELIBERATELY. The readiness wait can take up to ~30s, and the
# launcher prints which chains the server will see, whether any of them is MAINNET,
# and the teardown verdict. With Terminal=false all of that goes nowhere and a
# refusal is indistinguishable from the icon doing nothing (rule 14).
Terminal=true
Categories=Office;Finance;
Keywords=swap;crypto;gridcoin;xrp;
# StartupNotify=false, AND IT IS THE DIFFERENCE THAT MADE THE ICONS DEAD.
#
# Measured on the operator's own machine 2026-10-09. These were written with
# StartupNotify=true and clicking them did nothing. Their
# ~/Desktop/mammon-restart.desktop has worked since September and differs in
# exactly two ways -- this line, and Exec invoking /bin/bash explicitly.
#
# With StartupNotify=true the desktop waits for the launched application to send
# a startup-notification completion. A terminal emulator opening a shell script
# never sends one, so the launch sits pending and then silently gives up: the
# click registers and nothing appears. Terminal=true and StartupNotify=true are
# close to mutually exclusive for this reason, and every launcher on that desktop
# that actually works says false.
StartupNotify=false
